# Server
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=testdb

# Redis: pending logins, OTP state and rate limits
REDIS_URL=redis://localhost:6379

# JWT (required). At least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime, in seconds (default 900)
JWT_EXPIRES_IN=900
# Refresh token and session lifetime, in seconds (default 604800 = 7 days)
REFRESH_TOKEN_EXPIRES_IN=604800

# OTP (required). HMAC key for OTP codes and hashed Redis keys.
# At least 32 characters and different from JWT_SECRET: openssl rand -base64 48
OTP_SECRET=
